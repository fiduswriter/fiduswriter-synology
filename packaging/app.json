{
    "$schema": "https://raw.githubusercontent.com/moritzfl/synology-docker-bridge/main/packaging/app.schema.json",
    "id": "fiduswriter",
    "version": "5.0.0",
    "displayName": "Fidus Writer",
    "displayNameGer": "Fidus Writer",
    "description": "Online collaborative editor for academics — write with citations and formulas, publish to multiple formats.",
    "descriptionGer": "Online-Kollaborationseditor für Akademiker — schreiben mit Zitaten und Formeln, veröffentlichen in mehreren Formaten.",
    "maintainer": "Fidus Writer Team",
    "image": "fiduswriter-synology:spk",
    "appDir": "..",
    "appBuild": "docker build -t fiduswriter-synology:spk -f packaging/Dockerfile .",
    "containerPort": 8000,
    "icons": "packaging/icons",
    "allUsers": true,
    "identityHeaders": true,
    "appAuthenticatesRequests": true,
    "webPorts": {
        "http": 8098,
        "https": 8099
    },
    "publicPaths": [
        "/account/",
        "/bibliography/",
        "/document/",
        "/documents/",
        "/share/",
        "/pages/",
        "/user/",
        "/invite/",
        "/usermedia/",
        "/books/",
        "/templates/",
        "/api/",
        "/static/",
        "/media/",
        "/ws/"
    ],
    "publicCookies": ["csrftoken", "sessionid"],
    "files": {
        "/etc/fiduswriter-synology/configuration.py": "packaging/configuration.py",
        "/etc/fiduswriter-synology/start.sh": "packaging/start.sh"
    },
    "command": ["sh", "/etc/fiduswriter-synology/start.sh"],
    "configFile": {
        "path": "configuration.py",
        "label": "Fidus Writer settings"
    }
}
